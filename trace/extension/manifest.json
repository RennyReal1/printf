{
  "manifest_version": 3,
  "name": "Trace",
  "version": "0.1.0",
  "description": "Highlight a passage in a paper and get an explanation grounded in your own corpus.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trace"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
